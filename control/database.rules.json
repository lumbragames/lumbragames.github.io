{
  "rules": {
    ".read": "auth != null && auth.uid === 'ADMIN_UID'",
    ".write": false,
    "games": {
      ".write": "auth != null && auth.uid === 'ADMIN_UID'"
    },
    "admin": {
      ".write": "auth != null && auth.uid === 'ADMIN_UID'"
    },
    "remote": {
      ".read": "auth != null",
      ".write": "auth != null && auth.uid === 'ADMIN_UID'"
    },
    "players": {
      "$g": {
        "$u": {
          ".write": "auth != null && auth.uid === $u && auth.provider === 'anonymous' && root.child('games').child($g).exists()",
          ".validate": "newData.hasChildren(['last'])",
          "first": {
            ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
          },
          "last": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "sessions": {
            ".validate": "newData.isNumber() && newData.val() <= (data.exists() ? data.val() : 0) + 1"
          },
          "secs": {
            ".validate": "newData.isNumber() && newData.val() <= (data.exists() ? data.val() : 0) + 120"
          },
          "ver": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "os": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "osv": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "model": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "plat": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "lang": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "tz": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "scr": {
            ".validate": "newData.isString() && newData.val().length <= 12"
          },
          "sdk": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "sessions": {
      "$g": {
        ".indexOn": [
          "s",
          "l"
        ],
        "$s": {
          ".write": "auth != null && auth.provider === 'anonymous' && root.child('games').child($g).exists() && (data.exists() ? data.child('u').val() === auth.uid : newData.child('u').val() === auth.uid)",
          ".validate": "newData.hasChildren(['u', 's', 'l', 'd'])",
          "u": {
            ".validate": "newData.val() === auth.uid"
          },
          "s": {
            ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
          },
          "l": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "d": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400"
          },
          "v": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "n": {
            ".validate": "newData.isNumber() && (!data.exists() || data.val() === newData.val())"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "online": {
      "$g": {
        "$u": {
          ".write": "auth != null && auth.uid === $u && auth.provider === 'anonymous' && root.child('games').child($g).exists()",
          ".validate": "newData.hasChildren(['sid', 'l'])",
          "sid": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "l": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "v": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "events": {
      "$g": {
        ".indexOn": [
          "t",
          "u"
        ],
        "$e": {
          ".write": "auth != null && auth.provider === 'anonymous' && !data.exists() && root.child('games').child($g).exists()",
          ".validate": "newData.hasChildren(['u', 's', 'n', 't'])",
          "u": {
            ".validate": "newData.val() === auth.uid"
          },
          "s": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "ct": {
            ".validate": "newData.isNumber()"
          },
          "p": {
            "$k": {
              ".validate": "(newData.isString() && newData.val().length <= 60) || newData.isNumber()"
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "diag": {
      "$g": {
        ".indexOn": [
          "t"
        ],
        "$e": {
          ".write": "auth != null && auth.provider === 'anonymous' && !data.exists() && root.child('games').child($g).exists()",
          ".validate": "newData.hasChildren(['u', 'w', 'm', 't'])",
          "u": {
            ".validate": "newData.val() === auth.uid"
          },
          "w": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "m": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "ct": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "pr": {
      ".read": "auth != null",
      "prof": {
        ".indexOn": [
          "sc"
        ],
        "$u": {
          ".write": "auth != null && auth.provider === 'anonymous' && auth.uid === $u",
          ".validate": "newData.hasChildren(['n','sc'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 20"
          },
          "cl": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "c1": {
            ".validate": "newData.isString() && newData.val().length <= 9"
          },
          "c2": {
            ".validate": "newData.isString() && newData.val().length <= 9"
          },
          "sc": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000000"
          },
          "rep": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "ti": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2000"
          },
          "se": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
          },
          "fr": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "vip": {
            ".validate": "newData.isBoolean()"
          },
          "tt": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "lg": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
          },
          "chb": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "t": {
            ".validate": "newData.isNumber() && newData.val() <= now"
          },
          "v": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "$o": {
            ".validate": false
          }
        }
      },
      "ch": {
        "$w": {
          ".indexOn": [
            "sc"
          ],
          "$u": {
            ".write": "auth != null && auth.provider === 'anonymous' && auth.uid === $u",
            ".validate": "newData.hasChildren(['n','sc'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "sc": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
            },
            "fr": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "vip": {
              ".validate": "newData.isBoolean()"
            },
            "r": {
              ".validate": "newData.isString() && newData.val().length <= 60"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$o": {
              ".validate": false
            }
          }
        }
      },
      "lg": {
        "$c": {
          "meta": {
            ".write": "auth != null && auth.provider === 'anonymous' && (!data.exists() ? newData.child('own').val() === auth.uid : data.child('own').val() === auth.uid)",
            ".validate": "newData.hasChildren(['name','own','min','max','hr','st'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 30"
            },
            "own": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "min": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "max": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20"
            },
            "hr": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23"
            },
            "per": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
            },
            "st": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "start": {
              ".validate": "newData.isNumber()"
            },
            "v": {
              ".validate": "newData.isNumber()"
            },
            "t": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "$o": {
              ".validate": false
            }
          },
          "mem": {
            "$u": {
              ".write": "auth != null && auth.provider === 'anonymous' && auth.uid === $u && root.child('pr/lg/'+$c+'/meta').exists() && (data.exists() || root.child('pr/lg/'+$c+'/meta/st').val() === 'lobby')",
              "n": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "fr": {
                ".validate": "newData.isString() && newData.val().length <= 10"
              },
              "vip": {
                ".validate": "newData.isBoolean()"
              },
              "club": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "bud": {
                ".validate": "newData.isNumber()"
              },
              "j": {
                ".validate": "newData.isNumber() && newData.val() <= now"
              },
              "$o": {
                ".validate": false
              }
            }
          },
          "sq": {
            "$u": {
              ".write": "auth != null && auth.provider === 'anonymous' && auth.uid === $u"
            }
          },
          "ln": {
            "$u": {
              ".write": "auth != null && auth.provider === 'anonymous' && auth.uid === $u"
            }
          },
          "res": {
            "$r": {
              ".write": "auth != null && auth.provider === 'anonymous' && !data.exists() && root.child('pr/lg/'+$c+'/mem/'+auth.uid).exists()"
            }
          },
          "fa": {
            "$i": {
              ".write": "auth != null && auth.provider === 'anonymous' && !data.exists() && newData.val() === auth.uid"
            }
          },
          "of": {
            "$o": {
              ".write": "auth != null && auth.provider === 'anonymous' && (data.exists() ? (data.child('f').val() === auth.uid || data.child('to').val() === auth.uid) : newData.child('f').val() === auth.uid)"
            }
          }
        }
      }
    }
  }
}